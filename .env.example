# Server
NODE_ENV=development
PORT=3000

# CORS — frontend dev server URL
FRONTEND_URL=http://localhost:5173

# ── Self-hosting ──────────────────────────────────────────────────────────────
# Payments. 'off' runs without Stripe; every account gets every feature.
BILLING=stripe
# Email. 'off' runs without a mail server; password resets and email
# changes are then unavailable (use npm run account instead).
MAIL=smtp
# Photo and export storage: 's3' (R2 or any S3-compatible store) or
# 'local' (files under MEDIA_DIR).
MEDIA_STORAGE=s3
# Absolute path, required when MEDIA_STORAGE=local.
MEDIA_DIR=
# Optional. Any S3-compatible endpoint (for example MinIO). When set,
# R2_ACCOUNT_ID isn't needed. Must be reachable from users' browsers.
S3_ENDPOINT=

# ── Phase 02 will add ──────────────────────────
DATABASE_URL=
# false for a PostgreSQL without SSL
DATABASE_SSL=

# ── Phase 05 ──────────────────────────────────────────────────────────────────
SESSION_SECRET=<generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
SESSION_DAYS=7

# ── Phase 06 ──────────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank in development — emails are printed to the console instead
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vernal <noreply@vernal.garden>
APP_URL=http://localhost:3000
BCRYPT_ROUNDS=12

# ── Phase 07 ──────────────────────────────────────────────────────────────────
# Leave GOOGLE_* blank to turn Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY=       # 32 bytes as 64 hex chars — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

GUEST_SESSION_DAYS=30

# ── Phase 24 ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_LIFETIME=
STRIPE_SUCCESS_URL=http://localhost:5173/account/billing?success=true
STRIPE_CANCEL_URL=http://localhost:5173/account/billing

# ── Phase 28 ──────────────────────────────────────────────────────────────────
# Leave SENTRY_DSN blank to disable Sentry (default in development)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── Phase 37 ──────────────────────────────────────────────────────────────────
# Optional: Sentry links shown on the admin System page (leave blank to hide)
ADMIN_SENTRY_ISSUES_URL=
ADMIN_SENTRY_PERFORMANCE_URL=

# ── Phase 38 ──────────────────────────────────────────────────────────────────
# Cloudflare R2 (these names work for any S3-compatible store)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_EXPORTS_BUCKET_NAME=  # private bucket for data exports; public
                         # access OFF. Must differ from R2_BUCKET_NAME.

FEEDBACK_NOTIFY_EMAIL=<your address>

# ── Weather / geocoding origins ───────────────────────────────────────────────
# Leave blank to turn location weather off.
VISUAL_CROSSING_API_KEY=
# For tests only (E2E points these at a dead port); leave unset in production.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# VISUAL_CROSSING_BASE_URL=https://weather.visualcrossing.com
