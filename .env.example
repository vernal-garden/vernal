# Server
# Must be production, development or test (anything else stops startup).
# Unset counts as production. test is only for the test suites.
NODE_ENV=development
PORT=3000

# CORS — frontend URL. An https URL turns on secure cookies; http (LAN/local) leaves them off.
# FRONTEND_URL and APP_URL are both required when NODE_ENV is production or unset, and must be http(s) URLs.
FRONTEND_URL=http://localhost:5173

# ── Self-hosting ──────────────────────────────────────────────────────────────
# Payments. 'off' runs without Stripe; every account gets every feature.
BILLING=stripe
# Email. 'off' runs without a mail server; password resets and email
# changes are then unavailable (use npm run account instead).
MAIL_MODE=smtp
# Photo and export storage: 's3' (R2 or any S3-compatible store) or
# 'local' (files under MEDIA_DIR).
MEDIA_STORAGE=s3
# Absolute path, required when MEDIA_STORAGE=local.
# Files are created owner-only (0600, folders 0700). Upgrading from an older
# version? Run once: chmod -R go-rwx "$MEDIA_DIR"
MEDIA_DIR=
# Optional. Any S3-compatible endpoint (for example MinIO). When set,
# R2_ACCOUNT_ID isn't needed. Must be reachable from users' browsers.
S3_ENDPOINT=

# ── Phase 02 will add ──────────────────────────
DATABASE_URL=
# false for a PostgreSQL without SSL
DATABASE_SSL=
# Postgres certificates are always verified (Neon works out of the box).
# For a database with a private or self-signed CA, point this at the CA
# certificate (absolute path). Do not combine with DATABASE_SSL=false.
# TLS parameters in DATABASE_URL (sslmode etc.) are ignored.
DATABASE_SSL_CA=

# ── Phase 05 ──────────────────────────────────────────────────────────────────
SESSION_SECRET=<generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
SESSION_DAYS=7

# ── Phase 06 ──────────────────────────────────────────────────────────────────
# Required unless MAIL_MODE=off. Leave blank only with NODE_ENV=development on
# a local machine — emails are then printed to the console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vernal <noreply@vernal.garden>
# Required when NODE_ENV is production or unset; must be an http(s) URL (see FRONTEND_URL).
APP_URL=http://localhost:3000
BCRYPT_ROUNDS=12

# ── Phase 07 ──────────────────────────────────────────────────────────────────
# Leave GOOGLE_* blank to turn Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY=       # 32 bytes as 64 hex chars — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

GUEST_SESSION_DAYS=30

# ── Phase 24 ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_LIFETIME=
STRIPE_SUCCESS_URL=http://localhost:5173/account/billing?success=true
STRIPE_CANCEL_URL=http://localhost:5173/account/billing

# ── Phase 28 ──────────────────────────────────────────────────────────────────
# Leave SENTRY_DSN blank to disable Sentry (default in development)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# The browser's DSN (same value as the client's VITE_SENTRY_DSN). The browser
# sends its reports through POST /api/relay, which forwards only to this
# project. Blank turns the relay off: then a client with a DSN loses its reports.
SENTRY_CLIENT_DSN=

# ── Phase 37 ──────────────────────────────────────────────────────────────────
# Optional: Sentry links shown on the admin System page (leave blank to hide)
ADMIN_SENTRY_ISSUES_URL=
ADMIN_SENTRY_PERFORMANCE_URL=

# ── Phase 38 ──────────────────────────────────────────────────────────────────
# Cloudflare R2 (these names work for any S3-compatible store)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_EXPORTS_BUCKET_NAME=  # private bucket for data exports; public
                         # access OFF. Must differ from R2_BUCKET_NAME.

FEEDBACK_NOTIFY_EMAIL=<your address>

# Owner alerts and the daily summary. Falls back to FEEDBACK_NOTIFY_EMAIL.
ALERT_EMAIL_TO=
# Instant email on each new account. Set to false to leave new accounts
# to the daily summary only.
ALERT_INSTANT_SIGNUPS=true
# Hour (0-23, Pacific) the daily summary goes out.
ALERT_DIGEST_HOUR=7

# ── Weather / geocoding origins ───────────────────────────────────────────────
# Leave blank to turn location weather off.
VISUAL_CROSSING_API_KEY=
# For tests only (E2E points these at a dead port); leave unset in production.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# VISUAL_CROSSING_BASE_URL=https://weather.visualcrossing.com

# ── Phase 59 ──────────────────────────────────────────────────────────────────
# When the private beta page stops taking applications. ISO 8601 date and time
# with a UTC offset, for example 2027-01-01T00:00:00-08:00 or 2027-01-01T08:00:00Z.
# Unset means 2027-01-01T00:00:00-08:00.
BETA_APPLICATIONS_CLOSE_AT=

# ── Phase 60 ──────────────────────────────────────────────────────────────────
# When the private beta ends; activity after this instant does not count toward
# the lifetime tier. ISO 8601 date and time with a UTC offset, for example
# 2027-01-30T00:00:00-08:00. Unset means 2027-01-30T00:00:00-08:00 (the end of Jan 29 Pacific).
BETA_ENDS_AT=
# Days after BETA_ENDS_AT to keep beta participants' active weeks and
# survey credits. Blank = keep (General Counsel sets the number).
BETA_RECORDS_RETENTION_DAYS=
# When testers who qualify for the lifetime tier are asked their state.
LIFETIME_STATE_ASK_FROM=2027-01-11T00:00:00-08:00
# Set when the lifetime grant has been applied; the state question stops.
LIFETIME_GRANT_APPLIED_AT=
