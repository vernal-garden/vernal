# API origin, e.g. https://app.example.com. Leave blank to call the API on the same origin.
VITE_API_BASE_URL=
# Sentry DSN. Leave blank to disable error reporting. Reports go through the
# server's /api/relay, so set SENTRY_CLIENT_DSN on the server to the same value.
VITE_SENTRY_DSN=
# Sentry environment name, e.g. production or development.
VITE_SENTRY_ENVIRONMENT=
